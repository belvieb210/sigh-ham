# ─── Base de données PostgreSQL 17 (SIGH — HAM LABORATOIRE) ─────────────────
DATABASE_URL="postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/sigh_ham?schema=public"

# Redis — temps réel messagerie & notifications
REDIS_URL="redis://localhost:6379"

# Socket.IO (serveur temps réel)
SOCKET_PORT=3001
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret HMAC pour les QR codes des reçus publics (/r/[token])
# RECU_PUBLIC_SECRET="changez-moi-en-production"

# Web Push (VAPID) — générer avec: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@ham-laboratoire.local

# MinIO — pièces jointes (optionnel ; fallback local public/uploads/messagerie)
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=sigh-fichiers
# MINIO_PUBLIC_URL=http://localhost:9000
