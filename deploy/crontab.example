# =============================================================================
# SIGH HAM — Crontab VPS (root)
# Installation : bash /var/www/sigh-ham/deploy/install-crontab.sh
# =============================================================================

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

# ── Chaque minute — auto-deploy si git change OU dump dans inbox/ ─────────────
# (ne rebuild PAS si rien n'a changé ; verrou partagé avec deploy-app.sh)
* * * * * /var/www/sigh-ham/deploy/auto-deploy-cron.sh

# ── Tous les jours à 03:15 — backup PostgreSQL uniquement ────────────────────
15 3 * * * /var/www/sigh-ham/deploy/export-postgres.sh >> /var/www/sigh-ham/logs/cron-backup.log 2>&1

# Note SSL : géré par certbot.timer (ou cron SHK existant)
