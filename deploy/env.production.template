# Généré par deploy/install-vps.sh — ne pas committer (.env)

NODE_ENV=production

# PostgreSQL (créé par install-vps.sh)
DATABASE_URL="postgresql://sigh_app:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/sigh_ham?schema=public"

# Redis — messagerie / notifications temps réel
