{
  "name": "sigh-hopital",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:propre": "prisma generate && node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:seed:reception": "npx tsx prisma/seed-utilisateur-reception.ts",
    "db:seed:caisse": "npx tsx prisma/seed-utilisateur-caisse.ts",
    "db:seed:laboratoire": "npx tsx prisma/seed-utilisateur-laboratoire.ts",
    "db:seed:messagerie": "npx tsx prisma/seed-messagerie.ts",
    "db:export": "bash deploy/export-postgres.sh",
    "db:import": "bash deploy/import-postgres.sh",
    "db:migrate:vps": "bash deploy/migrate-db.sh",
    "db:purge:conversations-patient": "npx tsx prisma/supprimer-conversations-patient.ts",
    "dev:socket": "npx tsx server/socket-server.ts",
    "dev:full": "concurrently \"npm run dev:propre\" \"npm run dev:socket\"",
    "db:reset": "prisma migrate reset"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@prisma/adapter-pg": "^7.9.1",
