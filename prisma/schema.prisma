// Schéma SIGH — HAM LABORATOIRE
// Système Intégré de Gestion Hospitalière
// Communication inter-salles par transfert de dossier (pas d'accès croisé aux écrans)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Énumérations ───────────────────────────────────────────────────────────

enum CodeSalle {
  RECEPTION
  INFIRMIERS
  MEDECINS
  CAISSE
  LABORATOIRE
  PHARMACIE
  EGLISE
  MEDECINS_EXTERNES
  HOSPITALISATION
  ADMIN
  CLIENT
  MESSAGERIE
}

enum StatutUtilisateur {
  ACTIF
  INACTIF
  SUSPENDU
}

enum Sexe {
  MASCULIN
  FEMININ
  AUTRE
}

enum StatutDossier {
  OUVERT
  EN_COURS
  CLOTURE
  ARCHIVE
}

enum StatutPassage {
  EN_ATTENTE
  EN_COURS
  TERMINE
  ANNULE
}

enum StatutTransfert {
  EN_ATTENTE
  ACCEPTE
  EN_TRAITEMENT
  TERMINE
  REFUSE
  ANNULE
}

enum StatutRecuperationTransfert {
  EN_RECUPERATION
  RECUPERE
}

enum PrioriteFile {
  NORMALE
  URGENTE
  TRES_URGENTE
}

enum StatutFacture {
  BROUILLON
  EMISE
  PARTIELLEMENT_PAYEE
  PAYEE
  ANNULEE
}

enum ModePaiement {
  ESPECES
  MOBILE_MONEY
  CARTE
  VIREMENT
  CHEQUE
}

enum StatutExamen {
  PRESCRIT
  PRELEVE
  EN_ANALYSE
  TERMINE
  ANNULE
}

enum TypeConversation {
  DIRECT
  GROUPE
  CANAL_SALLE
  DIFFUSION
}

enum CategorieGroupe {
  GENERAL
  URGENCES
  BLOC_OPERATOIRE
  HOSPITALISATION
  ADMINISTRATION
  DIRECTION_MEDICALE
  INTER_SERVICES
}

enum RoleParticipant {
  ADMIN
  MEMBRE
}

enum PrioriteMessage {
  NORMALE
  URGENTE
  CRITIQUE
}

enum TypeMessage {
  TEXTE
  SYSTEME
  LIEN_PATIENT
  LIEN_TRANSFERT
  FICHIER
  IMAGE
  AUDIO
}

enum StatutPresence {
  EN_LIGNE
  HORS_LIGNE
  OCCUPE
  EN_CONSULTATION
  EN_LABORATOIRE
  ABSENT
}

enum TypeNotification {
  NOUVEAU_PATIENT
  PATIENT_TRANSFERE
  PATIENT_EN_ATTENTE
  CONSULTATION_TERMINEE
  PATIENT_A_CONSULTER
  RESULTATS_LABO
  PATIENT_A_FACTURER
  PAIEMENT_VALIDE
  EXAMENS_AUTORISES
  NOUVEL_EXAMEN
  RESULTAT_VALIDE
  ORDONNANCE_PRETE
  PAIEMENT_PHARMACIE
  NOUVELLE_ADMISSION
  DEMANDE_TRANSFERT
  SORTIE_PATIENT
  NOUVEL_UTILISATEUR
  SAUVEGARDE
  RAPPORT
  NOUVEAU_MESSAGE
  NOUVEAU_GROUPE
  MENTION
  DIFFUSION
  STOCK_FAIBLE
  STOCK_EPUISE
  MEDICAMENT_EXPIRATION
}

enum CanalNotification {
  IN_APP
  TABLEAU_BORD
  PUSH
  EMAIL
  SMS
}

enum TypePieceJointe {
  PDF
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  AUTRE
}

enum EmojiReaction {
  POUCES
  COEUR
  CHECK
  EPINGLE
  RIRE
  SURPRISE
}

enum StatutOrdonnance {
  EN_ATTENTE
  PARTIELLEMENT_DELIVREE
  DELIVREE
  ANNULEE
}

enum TypeVentePharmacie {
  ORDONNANCE
  DIRECTE
}

enum StatutVentePharmacie {
  BROUILLON
  TRANSMISE
  PAYEE
  REFUSEE
  DELIVREE
  ANNULEE
}

enum TypeMouvementStock {
  ENTREE
  SORTIE
  AJUSTEMENT
  RETOUR
}

enum StatutAchatPharmacie {
  BROUILLON
  RECU
  ANNULE
}

enum StatutAdmission {
  ADMIS
  EN_SOINS
  SORTI
  TRANSFERE
  DECEDE
}

enum TypeAudit {
  CONNEXION
  DECONNEXION
  CREATION
  MODIFICATION
  SUPPRESSION
  TRANSFERT
  CONSULTATION
  EXPORT
}

enum StatutRendezVous {
  DEMANDE
  CONFIRME
  ANNULE
  TERMINE
  ABSENT
}

enum StatutExamenPrenuptial {
  PLANIFIE
  EN_COURS
  TERMINE
  ANNULE
}

enum TypeEstimationHonoraires {
  CONVENTION_EGLISE
  MEDECIN_EXTERNE
}

enum StatutEstimationConvention {
  EMIS
  ENVOYEE_CAISSE
  TRAITE
  ANNULE
}

// ─── RBAC & Salles ──────────────────────────────────────────────────────────

model Salle {
  id          String    @id @default(cuid())
  code        CodeSalle @unique
  nom         String
  description String?
  actif       Boolean   @default(true)
  ordre       Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  roles                 Role[]
  transfertsOrigine     Transfert[]   @relation("TransfertOrigine")
  transfertsDestination Transfert[]   @relation("TransfertDestination")
  filesAttente          FileAttente[]
  membresVitrine        MedecinVitrine[]

  @@map("salles")
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  nom         String
  description String?
  salleId     String?  @map("salle_id")
  salle       Salle?   @relation(fields: [salleId], references: [id])
  systeme     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  utilisateurs Utilisateur[]
  permissions  RolePermission[]

  @@map("roles")
}

model Permission {
  id          String     @id @default(cuid())
  code        String     @unique
  nom         String
  description String?
  module      CodeSalle?
  createdAt   DateTime   @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("roles_permissions")
}

model Utilisateur {
  id                String            @id @default(cuid())
  identifiant       String            @unique
  email             String?           @unique
  motDePasseHash    String            @map("mot_de_passe_hash")
  prenom            String
  nom               String
  telephone         String?
  photoUrl          String?           @map("photo_url")
  statut            StatutUtilisateur @default(ACTIF)
  roleId            String            @map("role_id")
  role              Role              @relation(fields: [roleId], references: [id])
  medecinExterneId  String?           @unique @map("medecin_externe_id")
  medecinExterne    MedecinExterne?   @relation(fields: [medecinExterneId], references: [id])
  /** Accès messagerie suspendu par l'administration */
  messagerieBloquee Boolean           @default(false) @map("messagerie_bloquee")
  notesAdmin        String?           @map("notes_admin") @db.Text
  derniereConnexion DateTime?         @map("derniere_connexion")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  sessions                 Session[]
  transfertsEmis           Transfert[]               @relation("TransfertEmetteur")
  transfertsRecus          Transfert[]               @relation("TransfertRecepteur")
  consultations            Consultation[]
  constantesVitales        ConstantesVitales[]
  enregistrementsReception EnregistrementReception[]
  paiementsEnregistres     Paiement[]
  ordonnancesPrescrites    Ordonnance[]
  examensPrescrits         ExamenLaboratoire[]       @relation("ExamenPrescripteur")
  examensRealises          ExamenLaboratoire[]       @relation("ExamenTechnicien")
  journauxAudit            JournalAudit[]
  operationsGouvernancePatient OperationGouvernancePatient[]
  messagesEnvoyes          Message[]
  recuperationsRejetees    TransfertRecuperation[] @relation("RecuperationRejetePar")
  recuperationsRecuperees  TransfertRecuperation[] @relation("RecuperationRecuperePar")
  conversationsCreees      Conversation[]          @relation("ConversationCreateur")
  participationsMessagerie ParticipantConversation[]
  messagesLus              MessageLu[]
  presence                 PresenceUtilisateur?
  reactions                ReactionMessage[]
  estimationsConventionEmises EstimationConvention[] @relation("EstimationConventionEmetteur")
  estimationsConventionTraitees EstimationConvention[] @relation("EstimationConventionTraitePar")
  fichesTraitementCreees      FicheTraitement[]      @relation("FicheTraitementInfirmier")
  fichesTraitementCloturees   FicheTraitement[]      @relation("FicheTraitementCloturePar")
  mentionsRecues           MentionMessage[]        @relation("MentionDestinataire")
  messagesMasques          MessageMasque[]
  notifications            Notification[]
  preferencesNotification  PreferenceNotification?
  facturesApprouvees       Facture[]               @relation("FactureApprouveePar")
  abonnementsPush          AbonnementPush[]
  sessionsCaisse           SessionCaisse[]
  ventesPharmacie          VentePharmacie[]        @relation("VentePharmacien")
  delivrancesPharmacie     DelivrancePharmacie[]   @relation("DelivrancePharmacien")
  mouvementsStock          MouvementStock[]
  achatsPharmacie          AchatPharmacie[]        @relation("AchatPharmacien")
  retoursPharmacie         RetourPharmacie[]       @relation("RetourPharmacien")
  avertissementsRecus      ModerationAvertissement[] @relation("AvertissementDestinataire")
  avertissementsEmis       ModerationAvertissement[] @relation("AvertissementEmetteur")

  @@map("utilisateurs")
}

model Session {
  id            String      @id @default(cuid())
  utilisateurId String      @map("utilisateur_id")
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  tokenHash     String      @unique @map("token_hash")
  expireLe      DateTime    @map("expire_le")
  ipAddress     String?     @map("ip_address")
  userAgent     String?     @map("user_agent")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("sessions")
}

// ─── Patients & Dossiers ────────────────────────────────────────────────────

model Patient {
  id               String          @id @default(cuid())
  numeroPatient    String          @unique @map("numero_patient")
  prenom           String
  nom              String
  dateNaissance    DateTime?       @map("date_naissance")
  sexe             Sexe?
  telephone        String?
  email            String?
  adresse          String?
  ville            String?
  province         String?
  pays             String          @default("RD Congo")
  groupeSanguin    String?         @map("groupe_sanguin")
  allergies        String?
  contactUrgence   String?         @map("contact_urgence")
  telephoneUrgence String?         @map("telephone_urgence")
  photoUrl         String?         @map("photo_url")
  medecinExterneId String?         @map("medecin_externe_id")
  medecinExterne   MedecinExterne? @relation(fields: [medecinExterneId], references: [id])
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  dossiers DossierPatient[]
  recuperationsTransfert TransfertRecuperation[]
  conversations Conversation[]
  operationsGouvernance OperationGouvernancePatient[]

  @@map("patients")
}

model DossierPatient {
  id             String        @id @default(cuid())
  numeroDossier  String        @unique @map("numero_dossier") // VISYYYY###### (ex. VIS2026000001)
  patientId      String        @map("patient_id")
  patient        Patient       @relation(fields: [patientId], references: [id])
  statut         StatutDossier @default(OUVERT)
  motifOuverture String?       @map("motif_ouverture")
  ouvertLe       DateTime      @default(now()) @map("ouvert_le")
  clotureLe      DateTime?     @map("cloture_le")
  /** Salle qui a ouvert cette VIS — isole accueil / église / médecins externes. */
  salleEnregistrement CodeSalle @default(RECEPTION) @map("salle_enregistrement")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  passages                 Passage[]
  transferts               Transfert[]
  enregistrementsReception EnregistrementReception[]
  constantesVitales        ConstantesVitales[]
  consultations            Consultation[]
  factures                 Facture[]
  examensLaboratoire       ExamenLaboratoire[]
  ordonnances              Ordonnance[]
  admissions               Admission[]
  examensPrenuptiaux       ExamenPrenuptial[]
  recuperationsTransfert   TransfertRecuperation[]
  conversations            Conversation[]
  ventesPharmacie          VentePharmacie[]
  estimationsConvention    EstimationConvention[]
  fichesTraitement         FicheTraitement[]

  @@index([salleEnregistrement])
  @@map("dossiers_patients")
}

model Passage {
  id        String         @id @default(cuid())
  dossierId String         @map("dossier_id")
  dossier   DossierPatient @relation(fields: [dossierId], references: [id])
  statut    StatutPassage  @default(EN_ATTENTE)
  priorite  PrioriteFile   @default(NORMALE)
  motif     String?
  debutLe   DateTime?      @map("debut_le")
  finLe     DateTime?      @map("fin_le")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  transferts  Transfert[]
  fileAttente FileAttente?

  @@map("passages")
}

// ─── Transferts & Files d'attente (cœur du flux inter-salles) ───────────────

model Transfert {
  id                 String          @id @default(cuid())
  /** N° PAT du parcours (ex. PAT202600001) — identique pour tous les hops d'une même VIS. */
  numeroTransfert    String?         @map("numero_transfert")
  dossierId          String          @map("dossier_id")
  dossier            DossierPatient  @relation(fields: [dossierId], references: [id])
  passageId          String?         @map("passage_id")
  passage            Passage?        @relation(fields: [passageId], references: [id])
  salleOrigineId     String          @map("salle_origine_id")
  salleOrigine       Salle           @relation("TransfertOrigine", fields: [salleOrigineId], references: [id])
  salleDestinationId String          @map("salle_destination_id")
  salleDestination   Salle           @relation("TransfertDestination", fields: [salleDestinationId], references: [id])
  statut             StatutTransfert @default(EN_ATTENTE)
  priorite           PrioriteFile    @default(NORMALE)
  motif              String?
  notes              String?
  emetteurId         String          @map("emetteur_id")
  emetteur           Utilisateur     @relation("TransfertEmetteur", fields: [emetteurId], references: [id])
  recepteurId        String?         @map("recepteur_id")
  recepteur          Utilisateur?    @relation("TransfertRecepteur", fields: [recepteurId], references: [id])
  emisLe             DateTime        @default(now()) @map("emis_le")
  accepteLe          DateTime?       @map("accepte_le")
  termineLe          DateTime?       @map("termine_le")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  recuperation TransfertRecuperation?
  estimationConvention EstimationConvention?

  @@index([salleDestinationId, statut])
  @@index([dossierId])
  @@index([numeroTransfert])
  @@map("transferts")
}

model TransfertRecuperation {
  id            String                      @id @default(cuid())
  transfertId   String                      @unique @map("transfert_id")
  transfert     Transfert                   @relation(fields: [transfertId], references: [id], onDelete: Cascade)
  dossierId     String                      @map("dossier_id")
  dossier       DossierPatient              @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  patientId     String                      @map("patient_id")
  patient       Patient                     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  examensIds    String[]                    @map("examens_ids")
  motifRejet    String?                     @map("motif_rejet")
  rejeteParId   String                      @map("rejete_par_id")
  rejetePar     Utilisateur                 @relation("RecuperationRejetePar", fields: [rejeteParId], references: [id])
  rejeteLe      DateTime                    @default(now()) @map("rejete_le")
  recupereParId String?                     @map("recupere_par_id")
  recuperePar   Utilisateur?                @relation("RecuperationRecuperePar", fields: [recupereParId], references: [id])
  recupereLe    DateTime?                   @map("recupere_le")
  statut        StatutRecuperationTransfert @default(EN_RECUPERATION)

  @@index([dossierId])
  @@index([patientId])
  @@map("transferts_recuperation")
}

model FileAttente {
  id          String       @id @default(cuid())
  salleId     String       @map("salle_id")
  salle       Salle        @relation(fields: [salleId], references: [id])
  passageId   String       @unique @map("passage_id")
  passage     Passage      @relation(fields: [passageId], references: [id], onDelete: Cascade)
  numeroOrdre Int          @map("numero_ordre")
  priorite    PrioriteFile @default(NORMALE)
  arriveLe    DateTime     @default(now()) @map("arrive_le")
  appeleLe    DateTime?    @map("appele_le")
  serviLe     DateTime?    @map("servi_le")

  @@index([salleId, numeroOrdre])
  @@map("files_attente")
}

// ─── Réception ──────────────────────────────────────────────────────────────

model EnregistrementReception {
  id              String         @id @default(cuid())
  dossierId       String         @map("dossier_id")
  dossier         DossierPatient @relation(fields: [dossierId], references: [id])
  agentId         String         @map("agent_id")
  agent           Utilisateur    @relation(fields: [agentId], references: [id])
  typeVisite      String         @map("type_visite")
  assurance       String?
  numeroAssurance String?        @map("numero_assurance")
  observations       String?
  medecinResponsable String         @default("") @map("medecin_responsable")
  estEstimation      Boolean        @default(false) @map("est_estimation")
  /** Remise commerciale appliquée à l'estimation / proposée à la caisse (USD) */
  remise             Decimal        @default(0) @db.Decimal(12, 2)
  enregistreLe       DateTime       @default(now()) @map("enregistre_le")

  @@map("enregistrements_reception")
}

enum StatutFicheTraitement {
  EN_COURS
  CLOTURE
  ANNULE
}

// ─── Infirmiers ───────────────────────────────────────────────────────────────

model ConstantesVitales {
  id                    String         @id @default(cuid())
  dossierId             String         @map("dossier_id")
  dossier               DossierPatient @relation(fields: [dossierId], references: [id])
  infirmierId           String         @map("infirmier_id")
  infirmier             Utilisateur    @relation(fields: [infirmierId], references: [id])
  temperature           Decimal?       @db.Decimal(4, 1)
  tensionSystolique     Int?           @map("tension_systolique")
  tensionDiastolique    Int?           @map("tension_diastolique")
  frequenceCardiaque    Int?           @map("frequence_cardiaque")
  frequenceRespiratoire Int?           @map("frequence_respiratoire")
  poidsKg               Decimal?       @map("poids_kg") @db.Decimal(5, 2)
  tailleCm              Decimal?       @map("taille_cm") @db.Decimal(5, 1)
  saturationO2          Int?           @map("saturation_o2")
  glycemie              Decimal?       @db.Decimal(5, 2)
  observations          String?
  formulaireClinique    Json?          @map("formulaire_clinique")
  mesureLe              DateTime       @default(now()) @map("mesure_le")

  @@map("constantes_vitales")
}

model FicheTraitement {
  id                  String                @id @default(cuid())
  dossierId           String                @map("dossier_id")
  dossier             DossierPatient        @relation(fields: [dossierId], references: [id])
  infirmierId         String                @map("infirmier_id")
  infirmier           Utilisateur           @relation("FicheTraitementInfirmier", fields: [infirmierId], references: [id])
  medecinPrescripteur String?               @map("medecin_prescripteur")
  telPrescripteur     String?               @map("tel_prescripteur")
  numeroRecu          String?               @map("numero_recu")
  poidsKg             Decimal?              @map("poids_kg") @db.Decimal(5, 2)
  sexe                String?
  debutTraitementLe   DateTime              @map("debut_traitement_le")
  finTraitementLe     DateTime              @map("fin_traitement_le")
  joursProlongation   Int                   @default(0) @map("jours_prolongation")
  statut              StatutFicheTraitement @default(EN_COURS)
  pdfUrl              String?               @map("pdf_url")
  clotureLe           DateTime?             @map("cloture_le")
  clotureParId        String?               @map("cloture_par_id")
  cloturePar          Utilisateur?          @relation("FicheTraitementCloturePar", fields: [clotureParId], references: [id])
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  lignes       LigneTraitement[]
  commentaires CommentaireTraitement[]
  fichiers     FichierTraitement[]

  @@index([dossierId])
  @@index([statut])
  @@index([finTraitementLe])
  @@map("fiches_traitement")
}

model LigneTraitement {
  id           String          @id @default(cuid())
  ficheId      String          @map("fiche_id")
  fiche        FicheTraitement @relation(fields: [ficheId], references: [id], onDelete: Cascade)
  effectueLe   DateTime?       @map("effectue_le")
  medicament   String
  doseQuantite String?         @map("dose_quantite")
  nomTraiteur  String?         @map("nom_traiteur")
  ordre        Int             @default(0)

  @@map("lignes_traitement")
}

model CommentaireTraitement {
  id      String          @id @default(cuid())
  ficheId String          @map("fiche_id")
  fiche   FicheTraitement @relation(fields: [ficheId], references: [id], onDelete: Cascade)
  texte   String
  ordre   Int             @default(0)

  @@map("commentaires_traitement")
}

model FichierTraitement {
  id       String          @id @default(cuid())
  ficheId  String          @map("fiche_id")
  fiche    FicheTraitement @relation(fields: [ficheId], references: [id], onDelete: Cascade)
  nom      String
  url      String
  typeMime String?         @map("type_mime")
  ordre    Int             @default(0)

  @@map("fichiers_traitement")
}

// ─── Médecins ─────────────────────────────────────────────────────────────────

model Consultation {
  id                 String         @id @default(cuid())
  dossierId          String         @map("dossier_id")
  dossier            DossierPatient @relation(fields: [dossierId], references: [id])
  medecinId          String         @map("medecin_id")
  medecin            Utilisateur    @relation(fields: [medecinId], references: [id])
  motif              String
  anamnese           String?
  examenClinique     String?        @map("examen_clinique")
  conclusion         String?
  formulaireClinique Json?          @map("formulaire_clinique")
  debutLe            DateTime       @default(now()) @map("debut_le")
  finLe              DateTime?      @map("fin_le")

  diagnostics Diagnostic[]
  actes       PrescriptionActe[]

  @@map("consultations")
}

model Diagnostic {
  id             String       @id @default(cuid())
  consultationId String       @map("consultation_id")
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  codeCim        String?      @map("code_cim")
  libelle        String
  principal      Boolean      @default(false)

  @@map("diagnostics")
}

model PrescriptionActe {
  id             String       @id @default(cuid())
  consultationId String       @map("consultation_id")
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  typeActe       String       @map("type_acte")
  libelle        String
  quantite       Int          @default(1)
  notes          String?

  @@map("prescriptions_actes")
}

// ─── Caisse ───────────────────────────────────────────────────────────────────

model SessionCaisse {
  id             String       @id @default(cuid())
  caissierId     String       @map("caissier_id")
  caissier       Utilisateur  @relation(fields: [caissierId], references: [id])
  numeroCaisse   String       @default("01") @map("numero_caisse")
  soldeOuverture Decimal      @map("solde_ouverture") @db.Decimal(12, 2)
  ouverteLe      DateTime     @default(now()) @map("ouverte_le")
  clotureeLe     DateTime?    @map("cloturee_le")
  soldeCloture   Decimal?     @map("solde_cloture") @db.Decimal(12, 2)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([caissierId, clotureeLe])
  @@map("sessions_caisse")
}

model Facture {
  id            String         @id @default(cuid())
  numeroFacture String         @unique @map("numero_facture")
  dossierId     String         @map("dossier_id")
  dossier       DossierPatient @relation(fields: [dossierId], references: [id])
  statut        StatutFacture  @default(BROUILLON)
  montantTotal  Decimal        @map("montant_total") @db.Decimal(12, 2)
  montantPaye   Decimal        @default(0) @map("montant_paye") @db.Decimal(12, 2)
  devise        String         @default("USD")
  emiseLe       DateTime?      @map("emise_le")
  /** Validation caisse — débloque l'impression des codes-barres tubes */
  approuveeLe    DateTime?    @map("approuvee_le")
  approuveeParId String?      @map("approuvee_par_id")
  approuveePar   Utilisateur? @relation("FactureApprouveePar", fields: [approuveeParId], references: [id])
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  lignes    LigneFacture[]
  paiements Paiement[]
  ventePharmacie VentePharmacie?

  @@map("factures")
}

model LigneFacture {
  id           String  @id @default(cuid())
  factureId    String  @map("facture_id")
  facture      Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)
  libelle      String
  quantite     Int     @default(1)
  prixUnitaire Decimal @map("prix_unitaire") @db.Decimal(12, 2)
  montant      Decimal @db.Decimal(12, 2)

  @@map("lignes_facture")
}

model Paiement {
  id         String       @id @default(cuid())
  factureId  String       @map("facture_id")
  facture    Facture      @relation(fields: [factureId], references: [id])
  montant    Decimal      @db.Decimal(12, 2)
  mode       ModePaiement
  reference  String?
  caissierId String       @map("caissier_id")
  caissier   Utilisateur  @relation(fields: [caissierId], references: [id])
  payeLe     DateTime     @default(now()) @map("paye_le")

  @@map("paiements")
}

// ─── Laboratoire ──────────────────────────────────────────────────────────────

model TypeExamen {
  id             String  @id @default(cuid())
  code           String  @unique
  libelle        String
  categorie      String
  prix           Decimal @db.Decimal(12, 2)
  delaiHeures    Int     @default(24) @map("delai_heures")
  actif          Boolean @default(true)
  /** Inclus automatiquement à l'enregistrement Église (pack prénuptial). */
  packPrenuptial Boolean @default(false) @map("pack_prenuptial")
  formulaire     String?
  serviceLabo    String? @map("service_labo")
  specimen       String?
  uniteDefaut    String? @map("unite_defaut")
  rangeUsuelle   String? @map("range_usuelle")
  description    String? @db.Text

  parametres ParametreTypeExamen[]
  examens    ExamenLaboratoire[]
  paquetsBilan PaquetBilanExamen[]

  @@map("types_examen")
}

/// Regroupement d'examens facturés comme un seul bilan (prix forfaitaire).
model PaquetBilan {
  id          String   @id @default(cuid())
  code        String   @unique
  libelle     String
  description String?  @db.Text
  prix        Decimal  @db.Decimal(12, 2)
  actif       Boolean  @default(true)
  ordre       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  examens PaquetBilanExamen[]
  prescriptions ExamenLaboratoire[]

  @@map("paquets_bilans")
}

model PaquetBilanExamen {
  id            String      @id @default(cuid())
  paquetBilanId String      @map("paquet_bilan_id")
  paquetBilan   PaquetBilan @relation(fields: [paquetBilanId], references: [id], onDelete: Cascade)
  typeExamenId  String      @map("type_examen_id")
  typeExamen    TypeExamen  @relation(fields: [typeExamenId], references: [id], onDelete: Restrict)
  ordre         Int         @default(0)

  @@unique([paquetBilanId, typeExamenId])
  @@index([typeExamenId])
  @@map("paquets_bilans_examens")
}

model ParametreTypeExamen {
  id           String     @id @default(cuid())
  typeExamenId String     @map("type_examen_id")
  typeExamen   TypeExamen @relation(fields: [typeExamenId], references: [id], onDelete: Cascade)
  nom          String
  unite        String?
  rangeUsuelle String?    @map("range_usuelle")
  obligatoire  Boolean    @default(true)
  ordre        Int        @default(0)
  configSaisie Json?      @map("config_saisie")

  resultats ResultatExamen[]

  @@unique([typeExamenId, nom])
  @@map("parametres_type_examen")
}

model ExamenLaboratoire {
  id             String         @id @default(cuid())
  dossierId      String         @map("dossier_id")
  dossier        DossierPatient @relation(fields: [dossierId], references: [id])
  typeExamenId   String         @map("type_examen_id")
  typeExamen     TypeExamen     @relation(fields: [typeExamenId], references: [id])
  prescripteurId String         @map("prescripteur_id")
  prescripteur   Utilisateur    @relation("ExamenPrescripteur", fields: [prescripteurId], references: [id])
  technicienId   String?        @map("technicien_id")
  technicien     Utilisateur?   @relation("ExamenTechnicien", fields: [technicienId], references: [id])
  statut         StatutExamen   @default(PRESCRIT)
  preleveLe      DateTime?      @map("preleve_le")
  resultatLe     DateTime?      @map("resultat_le")
  rapportPdfUrl  String?        @map("rapport_pdf_url")
  notes          String?
  paquetBilanId  String?        @map("paquet_bilan_id")
  paquetBilan    PaquetBilan?   @relation(fields: [paquetBilanId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  resultats ResultatExamen[]

  @@map("examens_laboratoire")
}

model ResultatExamen {
  id                    String               @id @default(cuid())
  examenId              String               @map("examen_id")
  examen                ExamenLaboratoire    @relation(fields: [examenId], references: [id], onDelete: Cascade)
  parametreTypeExamenId String?              @map("parametre_type_examen_id")
  parametreTypeExamen   ParametreTypeExamen? @relation(fields: [parametreTypeExamenId], references: [id], onDelete: SetNull)
  parametre             String
  valeur                String
  unite                 String?
  normeMin              String?              @map("norme_min")
  normeMax              String?              @map("norme_max")
  nonRequis             Boolean              @default(false) @map("non_requis")
  anormal               Boolean              @default(false)
  flag                  String?
  valeurSecondaire      String?              @map("valeur_secondaire")
  commentaire           String?              @db.Text

  @@unique([examenId, parametreTypeExamenId])
  @@map("resultats_examen")
}

// ─── Pharmacie ────────────────────────────────────────────────────────────────

model Medicament {
  id            String   @id @default(cuid())
  code          String   @unique
  nom           String
  categorie     String?
  forme         String?
  dosage        String?
  prixAchat     Decimal? @map("prix_achat") @db.Decimal(12, 2)
  prixUnitaire  Decimal  @map("prix_unitaire") @db.Decimal(12, 2)
  stockMinimum  Int      @default(10) @map("stock_minimum")
  stockMaximum  Int?     @map("stock_maximum")
  emplacement   String?
  actif         Boolean  @default(true)
  firme         String?
  telephoneFirme String? @map("telephone_firme")
  classeMedicamenteuse String? @map("classe_medicamenteuse")
  voieAdministration String? @map("voie_administration")
  expirationLe  DateTime? @map("expiration_le") @db.Date
  recuPar       String?  @map("recu_par")
  autresInformations String? @map("autres_informations") @db.Text
  description   String?  @db.Text

  stocks             StockMedicament[]
  lots               LotMedicament[]
  lignesOrdonnance   LigneOrdonnance[]
  lignesVente        LigneVentePharmacie[]
  lignesAchat        LigneAchatPharmacie[]
  lignesRetour       LigneRetourPharmacie[]
  lignesDelivrance   LigneDelivrancePharmacie[]

  @@map("medicaments")
}

model StockMedicament {
  id           String     @id @default(cuid())
  medicamentId String     @map("medicament_id")
  medicament   Medicament @relation(fields: [medicamentId], references: [id])
  quantite     Int        @default(0)
  seuilAlerte  Int        @default(10) @map("seuil_alerte")
  lot          String?
  expirationLe DateTime?  @map("expiration_le")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("stocks_medicaments")
}

model FournisseurPharmacie {
  id        String   @id @default(cuid())
  nom       String
  telephone String?
  email     String?
  adresse   String?
  actif     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  lots   LotMedicament[]
  achats AchatPharmacie[]

  @@map("fournisseurs_pharmacie")
}

model LotMedicament {
  id             String                @id @default(cuid())
  numeroLot      String                @map("numero_lot")
  medicamentId   String                @map("medicament_id")
  medicament     Medicament            @relation(fields: [medicamentId], references: [id])
  quantite       Int                   @default(0)
  fabriqueLe     DateTime?             @map("fabrique_le")
  expirationLe   DateTime              @map("expiration_le")
  fournisseurId  String?               @map("fournisseur_id")
  fournisseur    FournisseurPharmacie? @relation(fields: [fournisseurId], references: [id])
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  mouvements       MouvementStock[]
  lignesVente      LigneVentePharmacie[]
  lignesDelivrance LigneDelivrancePharmacie[]
  lignesAchat      LigneAchatPharmacie[]
  lignesRetour     LigneRetourPharmacie[]

  @@unique([medicamentId, numeroLot])
  @@index([medicamentId, expirationLe])
  @@map("lots_medicaments")
}

model MouvementStock {
  id            String             @id @default(cuid())
  lotId         String             @map("lot_id")
  lot           LotMedicament      @relation(fields: [lotId], references: [id])
  type          TypeMouvementStock
  quantite      Int
  utilisateurId String             @map("utilisateur_id")
  utilisateur   Utilisateur        @relation(fields: [utilisateurId], references: [id])
  refType       String?            @map("ref_type")
  refId         String?            @map("ref_id")
  notes         String?
  creeLe        DateTime           @default(now()) @map("cree_le")

  @@index([lotId, creeLe])
  @@map("mouvements_stock")
}

model Ordonnance {
  id                   String           @id @default(cuid())
  dossierId            String           @map("dossier_id")
  dossier              DossierPatient   @relation(fields: [dossierId], references: [id])
  medecinId            String           @map("medecin_id")
  medecin              Utilisateur      @relation(fields: [medecinId], references: [id])
  statut               StatutOrdonnance @default(EN_ATTENTE)
  prescritLe           DateTime         @default(now()) @map("prescrit_le")
  notes                String?
  detailsPrescription  Json?            @map("details_prescription")

  lignes      LigneOrdonnance[]
  delivrances DelivrancePharmacie[]
  ventes      VentePharmacie[]

  @@map("ordonnances")
}

model LigneOrdonnance {
  id           String     @id @default(cuid())
  ordonnanceId String     @map("ordonnance_id")
  ordonnance   Ordonnance @relation(fields: [ordonnanceId], references: [id], onDelete: Cascade)
  medicamentId String     @map("medicament_id")
  medicament   Medicament @relation(fields: [medicamentId], references: [id])
  quantite     Int
  posologie    String?
  dureeJours   Int?       @map("duree_jours")

  @@map("lignes_ordonnance")
}

model VentePharmacie {
  id            String               @id @default(cuid())
  numero        String               @unique
  dossierId     String               @map("dossier_id")
  dossier       DossierPatient       @relation(fields: [dossierId], references: [id])
  type          TypeVentePharmacie
  ordonnanceId  String?              @map("ordonnance_id")
  ordonnance    Ordonnance?          @relation(fields: [ordonnanceId], references: [id])
  statut        StatutVentePharmacie @default(BROUILLON)
  factureId     String?              @unique @map("facture_id")
  facture       Facture?             @relation(fields: [factureId], references: [id])
  pharmacienId  String               @map("pharmacien_id")
  pharmacien    Utilisateur          @relation("VentePharmacien", fields: [pharmacienId], references: [id])
  notes         String?
  montantTotal  Decimal              @default(0) @map("montant_total") @db.Decimal(12, 2)
  creeLe        DateTime             @default(now()) @map("cree_le")
  transmiseLe   DateTime?            @map("transmise_le")
  payeeLe       DateTime?            @map("payee_le")
  delivreeLe    DateTime?            @map("delivree_le")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  lignes      LigneVentePharmacie[]
  delivrances DelivrancePharmacie[]
  retours     RetourPharmacie[]

  @@index([statut, creeLe])
  @@map("ventes_pharmacie")
}

model LigneVentePharmacie {
  id           String          @id @default(cuid())
  venteId      String          @map("vente_id")
  vente        VentePharmacie  @relation(fields: [venteId], references: [id], onDelete: Cascade)
  medicamentId String          @map("medicament_id")
  medicament   Medicament      @relation(fields: [medicamentId], references: [id])
  quantite     Int
  prixUnitaire Decimal         @map("prix_unitaire") @db.Decimal(12, 2)
  remise       Decimal         @default(0) @db.Decimal(12, 2)
  lotId        String?         @map("lot_id")
  lot          LotMedicament?  @relation(fields: [lotId], references: [id])

  @@map("lignes_vente_pharmacie")
}

model DelivrancePharmacie {
  id            String          @id @default(cuid())
  ordonnanceId  String?         @map("ordonnance_id")
  ordonnance    Ordonnance?     @relation(fields: [ordonnanceId], references: [id])
  venteId       String?         @map("vente_id")
  vente         VentePharmacie? @relation(fields: [venteId], references: [id])
  pharmacienId  String          @map("pharmacien_id")
  pharmacien    Utilisateur     @relation("DelivrancePharmacien", fields: [pharmacienId], references: [id])
  delivreLe     DateTime        @default(now()) @map("delivre_le")
  notes         String?

  lignes LigneDelivrancePharmacie[]

  @@map("delivrances_pharmacie")
}

model LigneDelivrancePharmacie {
  id           String              @id @default(cuid())
  delivranceId String              @map("delivrance_id")
  delivrance   DelivrancePharmacie @relation(fields: [delivranceId], references: [id], onDelete: Cascade)
  medicamentId String              @map("medicament_id")
  medicament   Medicament          @relation(fields: [medicamentId], references: [id])
  lotId        String              @map("lot_id")
  lot          LotMedicament       @relation(fields: [lotId], references: [id])
  quantite     Int

  @@map("lignes_delivrance_pharmacie")
}

model AchatPharmacie {
  id            String               @id @default(cuid())
  numero        String               @unique
  fournisseurId String               @map("fournisseur_id")
  fournisseur   FournisseurPharmacie @relation(fields: [fournisseurId], references: [id])
  pharmacienId  String               @map("pharmacien_id")
  pharmacien    Utilisateur          @relation("AchatPharmacien", fields: [pharmacienId], references: [id])
  statut        StatutAchatPharmacie @default(BROUILLON)
  notes         String?
  creeLe        DateTime             @default(now()) @map("cree_le")
  recuLe        DateTime?            @map("recu_le")

  lignes LigneAchatPharmacie[]

  @@map("achats_pharmacie")
}

model LigneAchatPharmacie {
  id           String         @id @default(cuid())
  achatId      String         @map("achat_id")
  achat        AchatPharmacie @relation(fields: [achatId], references: [id], onDelete: Cascade)
  medicamentId String         @map("medicament_id")
  medicament   Medicament     @relation(fields: [medicamentId], references: [id])
  lotId        String?        @map("lot_id")
  lot          LotMedicament? @relation(fields: [lotId], references: [id])
  numeroLot    String         @map("numero_lot")
  quantite     Int
  prixAchat    Decimal        @map("prix_achat") @db.Decimal(12, 2)
  expirationLe DateTime       @map("expiration_le")

  @@map("lignes_achat_pharmacie")
}

model RetourPharmacie {
  id           String         @id @default(cuid())
  venteId      String         @map("vente_id")
  vente        VentePharmacie @relation(fields: [venteId], references: [id])
  pharmacienId String         @map("pharmacien_id")
  pharmacien   Utilisateur    @relation("RetourPharmacien", fields: [pharmacienId], references: [id])
  motif        String?
  creeLe       DateTime       @default(now()) @map("cree_le")

  lignes LigneRetourPharmacie[]

  @@map("retours_pharmacie")
}

model LigneRetourPharmacie {
  id           String          @id @default(cuid())
  retourId     String          @map("retour_id")
  retour       RetourPharmacie @relation(fields: [retourId], references: [id], onDelete: Cascade)
  medicamentId String          @map("medicament_id")
  medicament   Medicament      @relation(fields: [medicamentId], references: [id])
  lotId        String          @map("lot_id")
  lot          LotMedicament   @relation(fields: [lotId], references: [id])
  quantite     Int

  @@map("lignes_retour_pharmacie")
}

// ─── Église (examens prénuptiaux) ─────────────────────────────────────────────

model ExamenPrenuptial {
  id            String                 @id @default(cuid())
  dossierId     String                 @map("dossier_id")
  dossier       DossierPatient         @relation(fields: [dossierId], references: [id])
  statut        StatutExamenPrenuptial @default(PLANIFIE)
  dateMariage   DateTime?              @map("date_mariage")
  paroisse      String?
  conjointNom   String?                @map("conjoint_nom")
  resultat      String?
  rapportPdfUrl String?                @map("rapport_pdf_url")
  certificatUrl String?                @map("certificat_url")
  planifieLe    DateTime               @default(now()) @map("planifie_le")
  termineLe     DateTime?              @map("termine_le")

  @@map("examens_prenuptiaux")
}

model EstimationConvention {
  id                 String                     @id @default(cuid())
  dossierId          String                     @map("dossier_id")
  dossier            DossierPatient             @relation(fields: [dossierId], references: [id])
  transfertId        String?                    @unique @map("transfert_id")
  transfert          Transfert?                 @relation(fields: [transfertId], references: [id])
  emetteurId         String                     @map("emetteur_id")
  emetteur           Utilisateur                @relation("EstimationConventionEmetteur", fields: [emetteurId], references: [id])
  typeEstimation     TypeEstimationHonoraires   @default(CONVENTION_EGLISE) @map("type_estimation")
  medecinExterneId   String?                    @map("medecin_externe_id")
  medecinExterne     MedecinExterne?            @relation(fields: [medecinExterneId], references: [id])
  nomConvention      String?                    @map("nom_convention")
  medecinResponsable String                     @map("medecin_responsable")
  sousTotalUsd       Decimal                    @map("sous_total_usd") @db.Decimal(12, 2)
  remiseUsd          Decimal                    @default(0) @map("remise_usd") @db.Decimal(12, 2)
  honorairePct       Decimal                    @default(5) @map("honoraire_pct") @db.Decimal(5, 2)
  honoraireUsd       Decimal                    @map("honoraire_usd") @db.Decimal(12, 2)
  totalPatientUsd    Decimal                    @map("total_patient_usd") @db.Decimal(12, 2)
  pdfUrl             String?                    @map("pdf_url")
  statut             StatutEstimationConvention @default(EMIS)
  emisLe             DateTime                   @default(now()) @map("emis_le")
  envoyeCaisseLe     DateTime?                  @map("envoye_caisse_le")
  traiteLe           DateTime?                  @map("traite_le")
  traiteParId        String?                    @map("traite_par_id")
  traitePar          Utilisateur?               @relation("EstimationConventionTraitePar", fields: [traiteParId], references: [id])
  lignes             EstimationConventionLigne[]

  @@index([dossierId])
  @@index([emisLe])
  @@index([statut])
  @@index([typeEstimation])
  @@index([medecinExterneId])
  @@map("estimations_convention")
}

model EstimationConventionLigne {
  id           String               @id @default(cuid())
  estimationId String               @map("estimation_id")
  estimation   EstimationConvention @relation(fields: [estimationId], references: [id], onDelete: Cascade)
  typeExamenId String?              @map("type_examen_id")
  code         String
  libelle      String
  prixUnitaire Decimal              @map("prix_unitaire") @db.Decimal(12, 2)

  @@map("estimation_convention_lignes")
}

// ─── Médecins externes (patients isolés) ──────────────────────────────────────

model MedecinExterne {
  id          String   @id @default(cuid())
  prenom      String
  nom         String
  specialite  String?
  telephone   String?
  email       String?
  numeroOrdre String?  @map("numero_ordre")
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  utilisateur Utilisateur?
  patients    Patient[]
  estimations EstimationConvention[]

  @@map("medecins_externes")
}

// ─── Hospitalisation ──────────────────────────────────────────────────────────

model Chambre {
  id       String  @id @default(cuid())
  numero   String  @unique
  service  String
  capacite Int     @default(1)
  actif    Boolean @default(true)

  lits       Lit[]
  admissions Admission[]

  @@map("chambres")
}

model Lit {
  id        String  @id @default(cuid())
  chambreId String  @map("chambre_id")
  chambre   Chambre @relation(fields: [chambreId], references: [id])
  numero    String
  occupe    Boolean @default(false)

  admissions Admission[]

  @@unique([chambreId, numero])
  @@map("lits")
}

model Admission {
  id        String          @id @default(cuid())
  dossierId String          @map("dossier_id")
  dossier   DossierPatient  @relation(fields: [dossierId], references: [id])
  chambreId String?         @map("chambre_id")
  chambre   Chambre?        @relation(fields: [chambreId], references: [id])
  litId     String?         @map("lit_id")
  lit       Lit?            @relation(fields: [litId], references: [id])
  statut    StatutAdmission @default(ADMIS)
  motif     String
  admisLe   DateTime        @default(now()) @map("admis_le")
  sortiLe   DateTime?       @map("sorti_le")
  notes     String?

  @@map("admissions")
}

// ─── Site public — Rendez-vous ────────────────────────────────────────────────

model DemandeRendezVous {
  id              String           @id @default(cuid())
  reference       String           @unique
  prenom          String
  nom             String
  telephone       String
  email           String?
  service         String
  typePrestation  String?          @map("type_prestation")
  creneau         String?
  motif           String?
  dateNaissance   DateTime?        @map("date_naissance")
  premiereVisite  Boolean?         @map("premiere_visite")
  dateSouhaitee   DateTime         @map("date_souhaitee")
  statut          StatutRendezVous @default(DEMANDE)
  notes           String?
  source          String           @default("SITE_PUBLIC")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([statut, dateSouhaitee])
  @@index([createdAt])
  @@map("demandes_rendez_vous")
}

// ─── Messagerie (Redis / WebSocket pour temps réel — phase 2) ─────────────────

model Conversation {
  id              String           @id @default(cuid())
  type            TypeConversation @default(DIRECT)
  sujet           String?
  salleCode       CodeSalle?       @map("salle_code")
  categorieGroupe CategorieGroupe? @map("categorie_groupe")
  patientId       String?          @map("patient_id")
  patient         Patient?         @relation(fields: [patientId], references: [id])
  dossierId       String?          @map("dossier_id")
  dossier         DossierPatient?  @relation(fields: [dossierId], references: [id])
  epingle         Boolean          @default(false)
  archivee        Boolean          @default(false)
  /** Bloquée par l'administration (modération) */
  bloquee         Boolean          @default(false)
  bloqueeLe       DateTime?        @map("bloquee_le")
  bloqueeParId    String?          @map("bloquee_par_id")
  bloqueeRaison   String?          @map("bloquee_raison")
  /** Groupe supprimé (soft delete admin) */
  supprimee       Boolean          @default(false)
  supprimeeLe     DateTime?        @map("supprimee_le")
  supprimeeParId  String?          @map("supprimee_par_id")
  photoUrl        String?          @map("photo_url")
  createurId      String?          @map("createur_id")
  createur        Utilisateur?     @relation("ConversationCreateur", fields: [createurId], references: [id])
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  participants ParticipantConversation[]
  messages     Message[]

  @@index([type, salleCode])
  @@index([patientId])
  @@index([dossierId])
  @@index([updatedAt])
  @@map("conversations")
}

model ParticipantConversation {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  utilisateurId  String       @map("utilisateur_id")
  utilisateur    Utilisateur  @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  role           RoleParticipant @default(MEMBRE)
  silencieux     Boolean      @default(false)
  epinglePerso   Boolean      @default(false) @map("epingle_perso")
  dernierLuLe    DateTime?    @map("dernier_lu_le")
  rejointLe      DateTime     @default(now()) @map("rejoint_le")

  @@unique([conversationId, utilisateurId])
  @@index([utilisateurId])
  @@map("participants_conversations")
}

model Message {
  id               String          @id @default(cuid())
  conversationId   String          @map("conversation_id")
  conversation     Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  expediteurId     String          @map("expediteur_id")
  expediteur       Utilisateur     @relation(fields: [expediteurId], references: [id])
  messageParentId  String?         @map("message_parent_id")
  messageParent    Message?        @relation("ReponsesMessage", fields: [messageParentId], references: [id])
  reponses         Message[]       @relation("ReponsesMessage")
  transfereDeId    String?         @map("transfere_de_id")
  type             TypeMessage     @default(TEXTE)
  priorite         PrioriteMessage @default(NORMALE)
  contenu          String
  metadonnees      Json?           @map("metadonnees")
  modifieLe        DateTime?       @map("modifie_le")
  supprime         Boolean         @default(false)
  supprimeLe       DateTime?       @map("supprime_le")
  /** Contenu conservé pour revue admin après suppression */
  contenuArchive   String?         @map("contenu_archive") @db.Text
  bloque           Boolean         @default(false)
  bloqueLe         DateTime?       @map("bloque_le")
  bloqueParId      String?         @map("bloque_par_id")
  bloqueRaison     String?         @map("bloque_raison")
  signale          Boolean         @default(false)
  signaleRaison    String?         @map("signale_raison")
  avertissementEnvoye Boolean      @default(false) @map("avertissement_envoye")
  envoyeLe         DateTime        @default(now()) @map("envoye_le")

  lectures      MessageLu[]
  piecesJointes PieceJointe[]
  reactions     ReactionMessage[]
  mentions      MentionMessage[]
  masques       MessageMasque[]

  @@index([conversationId, envoyeLe])
  @@index([messageParentId])
  @@map("messages")
}

model PieceJointe {
  id         String          @id @default(cuid())
  messageId  String          @map("message_id")
  message    Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  nom        String
  type       TypePieceJointe @default(DOCUMENT)
  mimeType   String          @map("mime_type")
  taille     Int
  url        String
  bucket     String?
  cleStockage String?        @map("cle_stockage")
  supprimee   Boolean        @default(false)
  supprimeeLe DateTime?      @map("supprimee_le")
  signalee    Boolean        @default(false)
  signaleRaison String?      @map("signalee_raison")
  envoyeLe   DateTime        @default(now()) @map("envoye_le")

  @@index([messageId])
  @@map("pieces_jointes")
}

model ReactionMessage {
  id            String        @id @default(cuid())
  messageId     String        @map("message_id")
  message       Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  utilisateurId String        @map("utilisateur_id")
  utilisateur   Utilisateur   @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  emoji         EmojiReaction
  creeLe        DateTime      @default(now()) @map("cree_le")

  @@unique([messageId, utilisateurId, emoji])
  @@map("reactions_messages")
}

model MentionMessage {
  id              String      @id @default(cuid())
  messageId       String      @map("message_id")
  message         Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  destinataireId  String      @map("destinataire_id")
  destinataire    Utilisateur @relation("MentionDestinataire", fields: [destinataireId], references: [id], onDelete: Cascade)

  @@unique([messageId, destinataireId])
  @@map("mentions_messages")
}

model PresenceUtilisateur {
  id            String         @id @default(cuid())
  utilisateurId String         @unique @map("utilisateur_id")
  utilisateur   Utilisateur    @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  statut        StatutPresence @default(HORS_LIGNE)
  messageStatut String?        @map("message_statut")
  dernierPing   DateTime       @default(now()) @map("dernier_ping")

  @@map("presences_utilisateurs")
}

/// Avertissement envoyé par un administrateur à un utilisateur (modération messagerie).
model ModerationAvertissement {
  id             String      @id @default(cuid())
  destinataireId String      @map("destinataire_id")
  destinataire   Utilisateur @relation("AvertissementDestinataire", fields: [destinataireId], references: [id], onDelete: Cascade)
  emetteurId     String      @map("emetteur_id")
  emetteur       Utilisateur @relation("AvertissementEmetteur", fields: [emetteurId], references: [id], onDelete: Cascade)
  messageId      String?     @map("message_id")
  conversationId String?     @map("conversation_id")
  contenu        String      @db.Text
  lu             Boolean     @default(false)
  creeLe         DateTime    @default(now()) @map("cree_le")

  @@index([destinataireId, lu])
  @@index([creeLe])
  @@map("moderation_avertissements")
}

model MessageLu {
  messageId     String      @map("message_id")
  message       Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  utilisateurId String      @map("utilisateur_id")
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  luLe          DateTime    @default(now()) @map("lu_le")

  @@id([messageId, utilisateurId])
  @@map("messages_lus")
}

model MessageMasque {
  messageId     String      @map("message_id")
  message       Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  utilisateurId String      @map("utilisateur_id")
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  masqueLe      DateTime    @default(now()) @map("masque_le")

  @@id([messageId, utilisateurId])
  @@map("messages_masques")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id            String           @id @default(cuid())
  utilisateurId String           @map("utilisateur_id")
  utilisateur   Utilisateur      @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  type          TypeNotification
  canal         CanalNotification @default(IN_APP)
  titre         String
  message       String
  module        CodeSalle?
  entite        String?
  entiteId      String?          @map("entite_id")
  lien          String?
  lu            Boolean          @default(false)
  archivee      Boolean          @default(false)
  metadonnees   Json?            @map("metadonnees")
  creeLe        DateTime         @default(now()) @map("cree_le")
  luLe          DateTime?        @map("lu_le")

  @@index([utilisateurId, lu, creeLe])
  @@index([type, creeLe])
  @@map("notifications")
}

model PreferenceNotification {
  id              String      @id @default(cuid())
  utilisateurId   String      @unique @map("utilisateur_id")
  utilisateur     Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  inApp           Boolean     @default(true) @map("in_app")
  tableauBord     Boolean     @default(true) @map("tableau_bord")
  push            Boolean     @default(false)
  son             Boolean     @default(true)
  email           Boolean     @default(false)
  sms             Boolean     @default(false)
  silencieux      Boolean     @default(false)
  typesSilencieux TypeNotification[] @map("types_silencieux")

  @@map("preferences_notifications")
}

model AbonnementPush {
  id            String      @id @default(cuid())
  utilisateurId String      @map("utilisateur_id")
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  endpoint      String      @unique
  p256dh        String      @map("p256dh")
  auth          String
  userAgent     String?     @map("user_agent")
  creeLe        DateTime    @default(now()) @map("cree_le")

  @@index([utilisateurId])
  @@map("abonnements_push")
}

// ─── Audit ────────────────────────────────────────────────────────────────────

model JournalAudit {
  id            String       @id @default(cuid())
  utilisateurId String?      @map("utilisateur_id")
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id])
  type          TypeAudit
  module        CodeSalle?
  entite        String
  entiteId      String?      @map("entite_id")
  action        String
  details       Json?
  ipAddress     String?      @map("ip_address")
  createdAt     DateTime     @default(now()) @map("created_at")
  operationGouvernance OperationGouvernancePatient?

  @@index([utilisateurId, createdAt])
  @@index([module, createdAt])
  @@map("journal_audit")
}

enum TypeOperationGouvernancePatient {
  CONSULTATION_RESULTATS
  ANNULATION_TRANSFERT
  RESTAURATION_TRANSFERT
  REINITIALISATION_VISITE
}

/** Trace durable des actions gouvernance patient (visible aussi dans le journal d'audit). */
model OperationGouvernancePatient {
  id             String                           @id @default(cuid())
  type           TypeOperationGouvernancePatient
  patientId      String                           @map("patient_id")
  patient        Patient                          @relation(fields: [patientId], references: [id])
  numeroPatient  String                           @map("numero_patient")
  dossierId      String?                          @map("dossier_id")
  numeroDossier  String?                          @map("numero_dossier")
  utilisateurId  String                           @map("utilisateur_id")
  utilisateur    Utilisateur                      @relation(fields: [utilisateurId], references: [id])
  journalAuditId String?                          @unique @map("journal_audit_id")
  journalAudit   JournalAudit?                    @relation(fields: [journalAuditId], references: [id])
  action         String
  snapshot       Json?
  createdAt      DateTime                         @default(now()) @map("created_at")

  @@index([patientId, createdAt])
  @@index([type, createdAt])
  @@map("operations_gouvernance_patient")
}

// ─── Administration / configuration système ──────────────────────────────────

model ParametreSysteme {
  cle         String   @id
  valeur      String   @db.Text
  categorie   String   @default("general")
  description String?
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([categorie])
  @@map("parametres_systeme")
}

// ─── Service Client — CMS site public ────────────────────────────────────────

model CampagnePublique {
  id                 String   @id @default(cuid())
  slug               String   @unique
  titre              String
  extrait            String   @db.Text
  description        String   @db.Text
  periode            String
  dateDebut          DateTime @map("date_debut")
  dateFin            DateTime @map("date_fin")
  categorie          String
  typePublication    String   @map("type_publication")
  publie             Boolean  @default(false)
  misEnAvant         Boolean  @default(false) @map("mis_en_avant")
  imageUrl           String?  @map("image_url")
  lieu               String?
  couleurFond        String   @default("#E8F4FC") @map("couleur_fond")
  couleurIllustration String  @default("#0B6E99") @map("couleur_illustration")
  couleurAccent      String   @default("#0B6E99") @map("couleur_accent")
  icone              String   @default("coeur")
  datePublication    DateTime? @map("date_publication")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  images             CampagneImage[]

  @@index([publie, dateDebut, dateFin])
  @@index([typePublication, publie])
  @@index([misEnAvant, publie])
  @@map("campagnes_publiques")
}

model CampagneImage {
  id         String           @id @default(cuid())
  campagneId String           @map("campagne_id")
  url        String
  ordre      Int              @default(0)
  legende    String?
  createdAt  DateTime         @default(now()) @map("created_at")
  campagne   CampagnePublique @relation(fields: [campagneId], references: [id], onDelete: Cascade)

  @@index([campagneId, ordre])
  @@map("campagne_images")
}

model DiapositiveHero {
  id        String   @id @default(cuid())
  url       String
  alt       String
  titre     String?
  lienHref  String?  @map("lien_href")
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([actif, ordre])
  @@map("diapositives_hero")
}

model PagePublique {
  id        String   @id @default(cuid())
  cle       String   @unique
  titre     String
  contenu   Json     @default("{}")
  publie    Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("pages_publiques")
}

model ServiceVitrine {
  id          String   @id @default(cuid())
  slug        String   @unique
  titre       String
  description String   @db.Text
  imageUrl    String?  @map("image_url")
  categorie   String   @default("diagnostic")
  pointsJson  Json     @default("[]") @map("points_json")
  badge       String?
  href        String?
  icone       String   @default("laboratoire")
  ordre       Int      @default(0)
  actif       Boolean  @default(true)
  estPhare    Boolean  @default(false) @map("est_phare")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  images      ServiceVitrineImage[]

  @@index([actif, ordre])
  @@index([estPhare, actif])
  @@map("services_vitrine")
}

model ServiceVitrineImage {
  id        String         @id @default(cuid())
  serviceId String         @map("service_id")
  url       String
  ordre     Int            @default(0)
  legende   String?
  createdAt DateTime       @default(now()) @map("created_at")
  service   ServiceVitrine @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, ordre])
  @@map("service_vitrine_images")
}

model MedecinVitrine {
  id          String   @id @default(cuid())
  nom         String
  prenom      String
  specialite  String
  bio         String?  @db.Text
  photoUrl    String?  @map("photo_url")
  horaires    String?
  telephone   String?
  email       String?
  salleId     String?  @map("salle_id")
  salle       Salle?   @relation(fields: [salleId], references: [id])
  /// MEDECIN | PERSONNEL | RESPONSABLE_LABO | MEDECIN_EXTERNE | SERVICE_EGLISE
  categorie   String   @default("MEDECIN")
  masquerContactsPublic Boolean @default(false) @map("masquer_contacts_public")
  badgeValeur1 String? @map("badge_valeur_1")
  badgeLibelle1 String? @map("badge_libelle_1")
  badgeValeur2 String? @map("badge_valeur_2")
  badgeLibelle2 String? @map("badge_libelle_2")
  badgeValeur3 String? @map("badge_valeur_3")
  badgeLibelle3 String? @map("badge_libelle_3")
  ordre       Int      @default(0)
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([actif, ordre])
  @@index([categorie, actif, ordre])
  @@index([salleId, actif, ordre])
  @@map("medecins_vitrine")
}

model MediaGalerie {
  id        String   @id @default(cuid())
  url       String
  type      String   @default("image")
  legende   String?
  album     String   @default("general")
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([album, actif, ordre])
  @@map("medias_galerie")
}

model MessageContact {
  id        String   @id @default(cuid())
  nom       String
  email     String
  telephone String?
  sujet     String
  message   String   @db.Text
  lu        Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([lu, createdAt])
  @@map("messages_contact")
}
